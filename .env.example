# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite in data directory. For PostgreSQL: postgresql://user:password@localhost:5432/crop_disease_db
DATABASE_URL=sqlite:///./crop_disease.db

# Authentication
# IMPORTANT: Generate a strong secret in production: openssl rand -hex 32
JWT_SECRET=supersecretcropdiseasejwtkey2026agriculturesecuretoken!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning & Inference
MODEL_PATH=./ml/model/crop_disease_model.keras
CONFIDENCE_THRESHOLD_HIGH=0.80
CONFIDENCE_THRESHOLD_MEDIUM=0.55

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
IMAGE_RETENTION_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
